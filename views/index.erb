<link rel="stylesheet" href="/style.css">

<div class="container">

  <header class="page-header">
    <h1>CookAssist</h1>
    <p>Find something delicious to make.</p>
  </header>


  <section class="search-section">

    <h2>Find Your Next Recipe</h2>

    <form action="/" method="get" class="search-form">

      <!-- Search by recipe name -->
      <div class="search-bar">

        <input
          type="text"
          name="search"
          placeholder="Search recipes by name..."
          value="<%= params[:search] %>"
        >

        <button type="submit">
          Search
        </button>

      </div>


      <div class="filters">

        <!-- Ingredient Filter -->
        <h3>Filter by Ingredients</h3>

        <div class="my-ingredients-filter">

          <button
            type="submit"
            name="use_my_ingredients"
            value="true"
            class="use-my-ingredients-btn"
          >
            Use My Ingredients
          </button>

          <a href="/ingredients">
            Manage My Ingredients
          </a>

        </div>


        <!-- Manual Ingredient Selection -->
        <div class="ingredient-scroll-box">

          <% all_ingredients.each do |ingredient| %>

            <label class="ingredient-option">

              <input
                type="checkbox"
                name="ingredients[]"
                value="<%= ingredient %>"
                <%= "checked" if selected_ingredients.include?(ingredient) %>
              >

              <span>
                <%= ingredient %>
              </span>

            </label>

          <% end %>

        </div>


        <!-- Cooking Time Filter -->
        <h3>Maximum Cooking Time</h3>

        <div class="time-filter">

          <input
            type="number"
            name="max_time"
            placeholder="e.g., 25"
            value="<%= params[:max_time] %>"
            min="1"
            max="180"
            class="time-input"
          >

          <span class="time-label">
            minutes
          </span>

        </div>


        <!-- Filter Buttons -->
        <div class="filter-actions">

          <button type="submit">
            Apply Filters
          </button>

          <a href="/">
            Clear
          </a>

        </div>

      </div>

    </form>

  </section>


  <!-- Recipes -->
  <section class="recipes-section">

    <div class="recipes-header">

      <h2>Recipes</h2>


      <div class="add-recipe-section">

        <a
          href="/recipes/new"
          class="add-recipe-btn"
        >
          + Add New Recipe
        </a>


        <a
          href="/ingredients"
          class="ingredient-manager-btn"
        >
          My Ingredients
        </a>

      </div>


      <p>
        Showing <%= recipes.length %>
        <%= recipes.length == 1 ? "recipe" : "recipes" %>
      </p>

    </div>


    <!-- No Results -->
    <% if recipes.empty? %>

      <div class="no-results">

        <h3>No recipes found</h3>

        <p>
          Try changing your search or filters.
        </p>

      </div>


    <% else %>


      <!-- Recipe Grid -->
      <div class="recipe-grid">

        <% recipes.each do |recipe| %>


          <article class="recipe-card">

            <div class="recipe-card-content">


              <!-- Recipe Name -->
              <h3>
                <%= recipe.name %>
              </h3>


              <!-- Cooking Time -->
              <p class="cook-time">
                ⏱ <%= recipe.cook_time %> minutes
              </p>


              <!-- Description -->
              <p class="recipe-description">
                <%= recipe.description %>
              </p>


              <!-- Ingredient Match Information -->
              <% if recipe_matches[recipe.name] %>

                <% match = recipe_matches[recipe.name] %>


                <div class="ingredient-match">


                  <!-- User has every ingredient -->
                  <% if match[:missing].empty? %>

                    <p class="ready-to-cook">
                      ✓ Ready to Cook
                    </p>


                  <!-- User is missing some ingredients -->
                  <% else %>

                    <p class="match-count">

                      You have

                      <strong>
                        <%= match[:matching_count] %>
                        of
                        <%= match[:total_count] %>
                      </strong>

                      ingredients

                    </p>


                    <p class="missing-ingredients">

                      <strong>
                        Missing:
                      </strong>

                      <%= match[:missing].join(', ') %>

                    </p>

                  <% end %>


                </div>

              <% end %>


              <!-- Recipe Actions -->

              <a
                class="view-recipe"
                href="/recipes/<%= recipe.name.downcase.gsub(" ", "-") %>/edit"
              >
                Edit →
              </a>


              <span style="margin: 0 10px;">
                |
              </span>


              <a
                class="view-recipe"
                href="/recipes/<%= recipe.name.downcase.gsub(" ", "-") %>"
              >
                View Recipe →
              </a>


            </div>

          </article>


        <% end %>

      </div>

    <% end %>

  </section>

</div>