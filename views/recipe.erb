<h1><%= recipe.name %></h1>

<p>
  <strong>Cooking time:</strong>
  <%= recipe.cook_time %> minutes
</p>

<p><%= recipe.description %></p>

<h2>Ingredients</h2>

<ul class="recipe-ingredient-list">

  <% recipe.ingredients.each do |ingredient_name| %>

    <% home_ingredient = ingredients.find do |item|
         item.name.downcase == ingredient_name.downcase
       end %>

    <li class="<%= home_ingredient&.available ? 'ingredient-have' : 'ingredient-missing' %>">

      <span>
        <%= home_ingredient&.available ? "✓" : "✕" %>
        <%= ingredient_name %>
      </span>

      <strong>
        <%= home_ingredient&.available ? "Have" : "Missing" %>
      </strong>

    </li>

  <% end %>

</ul>

  <p>
  <a href="/ingredients">Manage My Ingredients</a>
</p>

<h2>Steps</h2>

<ol>
  <% recipe.steps.each do |step| %>
    <li><%= step %></li>
  <% end %>
</ol>

<p>
  <a href="/">← Back to recipes</a>
</p>